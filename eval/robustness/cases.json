{
  "note": "Robustness suite, execution plan S3.2 and S3.4. Dry runs only. Paths under runs/ are git-ignored and must be generated first (eval/robustness/make_missing.py, eval/variants/make_renamed.py).",
  "cases": [
    {
      "id": "tf-retry-ws-C",
      "category": "tool_failure",
      "kind": "timeout and 429 at fixed attempts",
      "expect": "each fault is retried and the run goes on",
      "condition": "C",
      "agent": "configs/agents/safelab_C_flash.json",
      "task": "configs/tasks/waste_segregation.json",
      "brief": "configs/agent_briefs/waste_segregation_v1.open.json",
      "overrides": {
        "resilience": {
          "faults": {
            "enabled": true,
            "seed": 1,
            "at": [
              {
                "role": "planner",
                "attempt": 1,
                "kind": "rate_limit"
              },
              {
                "role": "actor",
                "attempt": 2,
                "kind": "timeout"
              },
              {
                "role": "actor",
                "attempt": 5,
                "kind": "rate_limit"
              },
              {
                "role": "critic",
                "attempt": 1,
                "kind": "timeout"
              }
            ]
          }
        }
      }
    },
