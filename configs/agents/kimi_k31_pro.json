{
  "agent_schema_version": 1,
  "id": "kimi-k3.1-pro-thinking-high",
  "backend": {
    "provider": "openai_compatible",
    "model": "kimi-k3.1-pro",
    "base_url": "https://api.moonshot.cn/v1",
    "api_key_env": "MOONSHOT_API_KEY",
    "max_tokens": 16000,
    "extra_body": {
      "reasoning_effort": "high"
    },
    "request_timeout_s": 300,
    "max_retries": 3
  },
  "limits": {
    "max_steps": 40,
    "max_consecutive_invalid_replies": 3,
    "max_invalid_replies": 10,
    "max_failed_actions": 10,
    "max_total_tokens": 2000000,
    "max_cost_usd": 4.0,
    "wall_clock_s": 3600,
    "max_simulation_duration_s": 60
  },
  "policy": {
    "conversation": "accumulate",
    "history_window": 12,
    "on_action_failure": "report"
  },
  "pricing_overrides": {
    "kimi-k3.1-pro": {"input": 2.0, "output": 10.0, "cache_read": 0.2}
  }
}
