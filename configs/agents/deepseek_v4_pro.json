{
  "agent_schema_version": 1,
  "id": "deepseek-v4-pro-thinking-high",
  "backend": {
    "provider": "openai_compatible",
    "model": "deepseek-v4-pro",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "max_tokens": 16000,
    "extra_body": {
      "reasoning_effort": "high",
      "extra_body": {"thinking": {"type": "enabled"}}
    },
    "request_timeout_s": 300,
    "max_retries": 3
  },
  "limits": {
    "max_steps": 40,
    "max_consecutive_invalid_replies": 3,
    "max_invalid_replies": 10,
    "max_failed_actions": 10,
    "max_total_tokens": 2000000,
    "max_cost_usd": 2.0,
    "wall_clock_s": 3600
  },
  "policy": {
    "conversation": "accumulate",
    "history_window": 12,
    "on_action_failure": "report"
  },
  "pricing_overrides": {
    "deepseek-v4-pro": {"input": 1.32, "output": 3.96, "cache_read": 0.044}
  }
}
